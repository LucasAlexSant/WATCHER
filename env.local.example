# Banco hospedado (opcional). Sem DATABASE_URL, o app usa PostgreSQL local via PGlite.
DATABASE_URL=
SOS_SEED=1

# Para túnel ou implantação. Use código forte e uma chave aleatória de 32 bytes ou mais.
SOS_OPERATOR_CODE=
SOS_OPERATOR_NAME=
SOS_SESSION_SECRET=

# Obrigatórios para o modo voz com o projeto Agora habilitado para Conversational AI.
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=
PUBLIC_URL=
# Opcional. Protege o início de sessões de voz em uma demonstração compartilhada.
SOS_VOICE_CODE=
SOS_DEBUG_AGENT_TOOLS=0

# Opcionais. REST API da Agora para notificar a central por Signaling.
AGORA_REST_KEY=
AGORA_REST_SECRET=

# Opcional. Ajuda a localizar endereços e sugerir o município do GPS.
GEOAPIFY_API_KEY=
